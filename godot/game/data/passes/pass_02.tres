[sub_resource type="Resource" id="Item_21"]
script = ExtResource("3")
id = 21
type = "AUTH"
size = 1
rows = 16
note = "KEY TLM"
key_for = "TLM"

[sub_resource type="Resource" id="Item_22"]
script = ExtResource("3")
id = 22
type = "TLM"
size = 1
rows = 32
note = "AUTO"
content = "HERALD TELEMETRY  T+214Y 077D
BUS      NOMINAL   BATTERY 61%
POWER    18 / DRAW 10 / SURPLUS 8
NAC      ON   WAC ON   SPC ON
AMP      ON   BANK B ON   HEATERS ON
POSITION PARKING ORBIT, PRIMA
POINTING NEXT PASS AZ +0.6 EL -0.4
STATUS   PHASE 2 AUTHORIZED. AWAITING ACK"

[sub_resource type="Resource" id="Paper_card"]
script = ExtResource("3_paper")
text = "TONIGHT'S PRAYER
SEEK THE VOICE AT
AZ %05.1f  EL %04.1f
BIND IT AT DIAL %.0f"
fields = PackedStringArray("card_azimuth", "card_elevation", "card_tuning")
size = Vector2(0.105, 0.074)

[resource]
script = ExtResource("1")
number = 2
aos = 30.0
speak = 135.0
los = 165.0
bell = 225.0
clock_start = 9600.0
card_azimuth = 221.3
card_elevation = 41.7
card_tuning = 55.0
card_seed = 2
