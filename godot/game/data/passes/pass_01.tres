[gd_resource type="Resource" script_class="PassWindow" format=3]

[ext_resource type="Script" path="res://scripts/pass/pass_window.gd" id="1"]
[ext_resource type="Resource" path="res://game/data/commands/station.tres" id="2"]
[ext_resource type="Script" path="res://scripts/room/papers/paper.gd" id="3_paper"]

[sub_resource type="Resource" id="Paper_letter"]
script = ExtResource("3_paper")
text = "Seek: set the brass wheels to the numbers on the Card, then turn slowly until the Voice comes out of the hiss. Bind: turn the black dial until the green lamp stops blinking. Speak: lean to the screen, type SEQ ADD ACK, and when the Speak lamp lights, type TX. Hold the Voice until it is sent. When the Voice is gone, pull the lamp chain and rest."

[sub_resource type="Resource" id="Paper_card"]
script = ExtResource("3_paper")
text = "TONIGHT'S PRAYER
SEEK THE VOICE AT
AZ %05.1f  EL %04.1f
BIND IT AT DIAL %.0f"
fields = PackedStringArray("card_azimuth", "card_elevation", "card_tuning")
size = Vector2(0.105, 0.074)

[resource]
script = ExtResource("1")
number = 1
aos = 30.0
speak = 95.0
los = 115.0
bell = 175.0
clock_start = 9600.0
card_azimuth = 214.6
card_elevation = 38.2
card_tuning = 52.0
card_seed = 1
papers = Array[ExtResource("3_paper")]([SubResource("Paper_letter"), SubResource("Paper_card")])
command_set = ExtResource("2")
