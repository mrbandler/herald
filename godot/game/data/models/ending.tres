[gd_resource type="Resource" script_class="EndingModel" format=3]

[ext_resource type="Script" path="res://scripts/room/ending_model.gd" id="1"]

[resource]
script = ExtResource("1")
ark_text = "THE WORD WENT DOWN, AND HERALD WENT WITH IT INTO THE DAUGHTER'S AIR. ITS LAST ROWS CONFIRMED WHAT YOU HAD ALREADY SEEN AND TASTED. AT DAWN THE PILLAR OPENED. THE WELL ROSE."
blind_text = "THE WORD WENT DOWN, AND HERALD WENT WITH IT. YOU HAD NOT SEEN HER CLEARLY, NOR TASTED HER AIR, AND STILL THE PILLAR OPENED. THE WELL ROSE INTO A SKY NOBODY HAD PROVEN."
transfer_text = "HERALD BURNED FOR TARBA AND THE VERDICT WAITS ANOTHER LIFETIME. SOMEONE ELSE WILL SIT IN THIS CHAIR, READ YOUR NOTES, AND LISTEN."
silence_text = "NO WORD WENT UP. HERALD CIRCLED THE DAUGHTER UNTIL ITS POWER FAILED. THE PILLAR STAYED SEALED, AND THE LAST LOG ENTRY IS YOURS."
