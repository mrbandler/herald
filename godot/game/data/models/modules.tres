"IMG": PackedStringArray("IMG DECODER V2.1  (C) SOWING PROGRAMME", "DECODE <ID>   TUNE AN IMAGE ON THE MONITOR", "  CAL <ID>    LET A CAL SET THE KNOBS", "SHOW <ID>     LOOK AT IT AGAIN", "MANUAL: SYS:IMG.MAN")
