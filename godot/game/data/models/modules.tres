"IMG": "SLOW-SCAN IMAGES ON THE MONITOR",
"SPC": "SPECTRA AS A CHARACTER CHART",
"TLM": "TELEMETRY: HEALTH, POWER, POSITION"
})
banners = Dictionary[String, PackedStringArray]({
