[resource]
script = ExtResource("1_script")
name = "SEQ"
help = "SEQ               LIST THE PROBE SEQUENCE
SEQ ADD <CMD>     QUEUE A PROBE COMMAND
SEQ CLR           CLEAR THE SEQUENCE"
