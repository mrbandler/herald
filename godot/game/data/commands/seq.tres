[gd_resource type="Resource" script_class="SeqCommand" format=3]

[ext_resource type="Script" path="res://scripts/terminal/commands/seq_command.gd" id="1_script"]
[ext_resource type="Resource" path="res://game/data/atoms/terminal/stdout.tres" id="2_stdout"]
[ext_resource type="Resource" path="res://game/data/atoms/uplink/sequence.tres" id="3_sequence"]
