[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/room/wake_card.gd" id="1_wake"]
[ext_resource type="Theme" path="res://game/data/ui/crt.tres" id="2_theme"]
[ext_resource type="Shader" path="res://game/ui/crt_overlay.gdshader" id="3_overlay"]
[ext_resource type="AudioStream" path="res://assets/boot/boot.ogg" id="4_boot"]

[sub_resource type="ShaderMaterial" id="Material_overlay"]
shader = ExtResource("3_overlay")

[node name="WakeCard" type="CanvasLayer" node_paths=PackedStringArray("panel", "clock", "bar", "boot_sound")]
layer = 30
script = ExtResource("1_wake")
panel = NodePath("Panel")
clock = NodePath("Panel/Column/Clock")
bar = NodePath("Panel/Column/Power/Bar")
boot_sound = NodePath("BootSound")

[node name="Panel" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
color = Color(0.07, 0.048, 0.02, 1)

[node name="Column" type="VBoxContainer" parent="Panel"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -180.0
offset_right = 360.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 26
alignment = 1

[node name="Station" type="Label" parent="Panel/Column"]
theme_override_colors/font_color = Color(0.6, 0.42, 0.14, 1)
text = "LISTENING POST 4
LEAVING STANDBY"
horizontal_alignment = 1

[node name="Clock" type="Label" parent="Panel/Column"]
theme_override_font_sizes/font_size = 34
text = "T+ 214Y 077D
02:40:00"
horizontal_alignment = 1

[node name="Power" type="VBoxContainer" parent="Panel/Column"]
theme_override_constants/separation = 6

[node name="Tag" type="Label" parent="Panel/Column/Power"]
theme_override_colors/font_color = Color(0.85, 0.62, 0.22, 1)
text = "RESTORING STATION POWER"
horizontal_alignment = 1

[node name="Bar" type="Label" parent="Panel/Column/Power"]
theme_override_colors/font_color = Color(0.85, 0.62, 0.22, 1)
text = "[------------------------------]"
horizontal_alignment = 1

[node name="Glass" type="ColorRect" parent="Panel"]
material = SubResource("Material_overlay")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="BootSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_boot")
volume_db = -4.0
